# ====== SMS Gateway sozlamalari (.env.example -> .env ga nusxalang) ======

# Admin (faqat birinchi ishga tushirishda yaratiladi; keyin panelda o'zgartiring)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ozgartiring-12345

# Bo'sh qoldirsangiz data/secret.key ga avtomatik yaratiladi
SECRET_KEY=

TIMEZONE=Asia/Tashkent

# HTTPS (Cloudflare) orqali ochilganda true qiling
COOKIE_SECURE=false

# /docs (Swagger) sahifasi. Ishlab chiqarishda false tavsiya etiladi
ENABLE_DOCS=false

# ---- Modem (USB modemlar avtomatik qidiriladi) ----
SCAN_INTERVAL=15
# Portni qo'lda ko'rsatish (odatda kerak emas). Masalan: /dev/ttyUSB2  yoki  COM5
SERIAL_PORTS=
# Boshqa dastur ishlatadigan portlarga TEGILMASIN (vergul bilan). Masalan: /dev/ttyUSB0,/dev/ttyUSB1
SERIAL_EXCLUDE=

# ---- Docker ----
HTTP_PORT=8000
# Cloudflare Tunnel tokeni (Zero Trust -> Networks -> Tunnels)
TUNNEL_TOKEN=
